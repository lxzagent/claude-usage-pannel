<?xml version="1.0" encoding="UTF-8"?>
<!-- 模板：占位符由 launchd/install.sh 按本机实际 node 路径 / 仓库位置替换后写入 ~/Library/LaunchAgents/。
     请勿手工拷贝本文件——直接跑 `bash launchd/install.sh`。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lxz.claude-usage</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/dist/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__NODE_DIR__:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/claude-usage.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-usage.err.log</string>
</dict>
</plist>
