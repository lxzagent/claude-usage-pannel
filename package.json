{
  "name": "claude-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "claude-usage": "dist/server.js"
  },
  "scripts": {
    "build:collector": "esbuild src/collect-cli.ts --bundle --platform=node --format=cjs --outfile=collector.bundle.cjs",
    "dev": "npm run build:collector && tsx src/server.ts",
    "collect": "tsx src/collect-cli.ts",
    "build": "tsc -p tsconfig.json && npm run build:collector",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.24",
    "tsx": "^4",
    "typescript": "^5"
  }
}
